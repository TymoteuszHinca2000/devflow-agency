{
  "name": "devflow-agency",
  "private": true,
  "version": "0.1.0",
  "description": "A modular agency management platform, built incrementally.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25 || >=26.0.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --test --test-concurrency=1 supabase/tests/*.test.mjs",
    "db:types": "node scripts/database-types.mjs",
    "db:types:check": "node scripts/database-types.mjs --check",
    "supabase": "supabase",
    "supabase:verify": "node scripts/verify-supabase.mjs",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run format:check && npm run test && npm run test:db && npm run db:types:check && npm run build",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-router": "8.4.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@supabase/typegen": "0.2.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
